    <string name="ai_cache_title">保存同步结果</string>
    <string name="ai_cache_summary">AI 同步过的歌曲下次从一开始就是同步的。每首歌在 Spotify 缓存中约占 10 KB。</string>
    <string name="ai_cache_limit">空间上限</string>
    <string name="ai_cache_clear">清除已保存的同步</string>
    <string name="ai_cache_cleared">已清除保存的同步</string>
    <string name="lyrics_source_spotify">Spotify 自己的歌词，通过 SpotifyPlus API</string>
    <string name="lyrics_source_lrc_red">按录音匹配的 Apple 时间轴，逐音节</string>
    <string name="lyrics_source_bini">同样的 Apple 时间轴，按录音本身匹配</string>
    <string name="lyrics_source_better">Apple Music 时间轴，逐词</string>
    <string name="lyrics_source_better_portato">通过 BetterLyrics 的 QQ 音乐卡拉 OK 时间轴</string>
    <string name="lyrics_source_paxsenix">通过 PaxSenix 的 Apple Music 时间轴</string>
    <string name="lyrics_source_paxsenix_spotify">通过 PaxSenix 的 Spotify 歌词</string>
    <string name="lyrics_source_paxsenix_musixmatch">通过 PaxSenix 的 Musixmatch 时间轴</string>
    <string name="lyrics_source_lyrics_plus">逐音节，来自社区镜像</string>
    <string name="lyrics_source_unison">由听众贡献</string>
    <string name="lyrics_source_kugou">整行歌词，非英语曲库很强</string>
    <string name="lyrics_source_lrclib">整行歌词，免费且一直可用</string>
    <string name="lyrics_source_musixmatch">需要签名密钥；几乎不会返回结果</string>
    <string name="lyrics_source_genius">备用纯文本，曲库庞大</string>
    <string name="feature_glass_sheets_title">玻璃面板和对话框</string>
    <string name="feature_glass_sheets_summary">模糊 Connect、\"…\" 菜单和对话框后面的内容。</string>
    <string name="feature_keep_running_title">始终保持 Spotify 运行</string>
    <string name="feature_keep_running_summary">即使从最近使用的应用中清除 Spotify，音乐也会在后台继续播放。重启 Spotify 后生效。</string>
    <string name="pref_dump_ui_title">记录界面结构</string>
    <string name="pref_dump_ui_summary">下次打开时把导航栏、播放器和面板的结构写入日志。用于报告问题。</string>
    <string name="pref_navbar_layout_title">导航栏布局</string>
    <string name="navbar_layout_three_tabs">三个标签页</string>
    <string name="navbar_layout_search_bubble">搜索单独放</string>
    <string name="navbar_layout_create_bubble">创建单独放</string>
    <string name="option_navbar_lens_title">拖动导航栏时显示透镜</string>
    <string name="option_navbar_lens_summary">在标签页上按住并拖动，会浮起一个放大下方内容的玻璃透镜。仅限液态样式。</string>
    <string name="option_navbar_minimize_title">滚动时缩小导航栏</string>
    <string name="option_navbar_minimize_summary">向下滚动时，标签页会变成一个圆，迷你播放器移到导航栏里，就像 iOS 26。向上滚动或点按圆圈即可恢复。</string>
    <string name="option_miniplayer_compact_title">紧凑迷你播放器</string>
    <string name="option_miniplayer_compact_summary">只显示封面、歌曲、暂停和下一首，不显示 Connect 和添加按钮。</string>
    <string name="option_player_canvas_off_title">在播放器中关闭 Canvas</string>
    <string name="option_player_canvas_off_summary">始终显示封面，而不是歌曲的循环短视频。</string>
    <string name="option_player_lyric_line_title">播放器中的歌词行</string>
    <string name="option_player_lyric_line_summary">在进度条上方显示正在演唱的歌词行；点按可打开歌词。</string>
    <string name="pref_glass_style_title">样式</string>
    <string name="glass_style_liquid">液态</string>
    <string name="glass_style_frosted">磨砂</string>
    <string name="glass_style_solid">纯色</string>
    <string name="glass_style_matte">哑光</string>
    <string name="glass_style_matte_summary">磨砂的模糊加上更浓的颜色，没有 Liquid Glass 的边缘和光泽。</string>
    <string name="glass_style_liquid_summary">模糊和透镜折射。在 Android 12 上使用磨砂。</string>
    <string name="glass_style_frosted_summary">更强的模糊，无透镜。更省电。</string>
    <string name="glass_style_solid_summary">纯色，无模糊。</string>
    <string name="pref_reduce_motion_title">减少动画</string>
    <string name="pref_reduce_motion_summary">关闭导航栏和播放器的弹簧动画，以及歌词的逐音节动画。</string>
    <string name="pref_debug_logging_title">调试日志</string>
    <string name="pref_debug_logging_summary">写入详细日志（标签 LiquidSpot）。</string>
    <string name="features_need_service">连接 LSPosed 服务后才能更改功能。</string>

